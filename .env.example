# Backend (read by app/core/config.py)
PARTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PARTI_LOG_LEVEL=INFO
# Directory with a built web client to serve at / (defaults to frontend/dist)
# PARTI_STATIC_DIR=/app/static

# Frontend
# Where the Vite dev server proxies /api (default http://localhost:8000)
# PARTI_API_URL=http://localhost:8000
# Absolute API origin baked into a production build, if the API lives elsewhere
# VITE_API_BASE=https://api.example.com
